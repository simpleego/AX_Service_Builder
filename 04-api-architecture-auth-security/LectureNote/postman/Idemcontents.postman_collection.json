{
  "info": {
    "name": "Idemcontents · 멱등성 추가 실습",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Idemcontents 서버와 Todo local 환경에서 전체를 순서대로 실행. 최초 응답 재생/충돌/GET/PATCH/DELETE 반복 검증."
  },
  "item": [
    {
      "name": "01 가입 및 환경 초기화",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "description": "상태코드를 확인하고 필요한 응답값을 환경변수로 저장합니다. 순서대로 실행하세요.",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{emailA}}\", \"password\": \"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 반복 실행 시 중복 이메일을 피한다. secret 대신 공개된 실습용 비밀번호만 사용한다.",
              "const run=Date.now()+'-'+Math.random().toString(16).slice(2);",
              "pm.environment.set('emailA','student-a-'+run+'@example.com');",
              "pm.environment.set('emailB','student-b-'+run+'@example.com');",
              "for (const key of ['accessToken','refreshToken','accessTokenB','refreshTokenB','oldRefreshToken','todoId']) pm.environment.unset(key);",
              "pm.environment.set('idemKey','todo-'+Date.now()+'-'+Math.random().toString(16).slice(2));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "02 로그인 및 토큰 저장",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "description": "상태코드를 확인하고 필요한 응답값을 환경변수로 저장합니다. 순서대로 실행하세요.",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{emailA}}\", \"password\": \"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if(pm.response.code===200){ const t=pm.response.json(); pm.environment.set('accessToken',t.accessToken); pm.environment.set('refreshToken',t.refreshToken); }"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "03 키 있는 최초 생성",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idemKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/todos",
        "body": {
          "mode": "raw",
          "raw": "{\"title\": \"멱등성 실습\", \"completed\": false}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "pm.environment.set('todoId',pm.response.json().id); pm.environment.set('idemOriginal',JSON.stringify(pm.response.json())); pm.environment.set('idemLocation',pm.response.headers.get('Location')); pm.test('최초 생성',()=>pm.expect(pm.response.headers.get('Idempotency-Replayed')).to.eql('false'));"
            ]
          }
        }
      ]
    },
